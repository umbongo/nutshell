# Build artefacts
*.o
*.a
# *.exe
*.obj
#build/
test_runner
build/win/test_runner.exe

# Runtime configuration (may contain encrypted credentials)
nutshell.config
settings.ini

# Session log files
*.log

# Claude Code project data: local state stays ignored; tracked memory,
# skills and their change log are re-included (see CLAUDE.md).
.claude/*
!.claude/memory/
!.claude/skills/
!.claude/CHANGELOG.md
.superpowers/


# Editor files
*.swp
*~

# Backups
backups/
# Native-host test artefacts
build/test_runner.exe
build/.detect*

# Integration test output
tests/integration/artifacts/
tests/integration/.ai_key
tests/integration/.ai_config/

# busybox-w32 sidecar copies used for local shell testing, anchored so a
# future committed payload under third_party/ is not ignored (local shell
# spec 2026-09-22, section 4.4)
/busybox64.exe
/build/win/busybox64.exe
