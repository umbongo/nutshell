#include <windows.h>
#include "resource.h"

/*
 * Two-column session manager:
 *   Left  (x=4..187):   saved session list + New / Edit / Delete
 *   Right (x=191..526): connection form + Save / Connect / Cancel
 *
 * Dialog units:  530 wide × 337 tall
 * At 96 DPI / MS Shell Dlg 8pt this is roughly 795 × 546 px.
 */
IDD_SESSION_MANAGER DIALOGEX 0, 0, 530, 337
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Session Manager"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    /* ---- Left column: saved sessions ---- */
    LTEXT           "Sessions",         -1,            12,   6, 158,   8
    LISTBOX         IDC_LIST_SESSIONS,                 12,  18, 158, 292, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_TABSTOP
    PUSHBUTTON      "New",              IDC_BTN_NEW,   12, 315,  47,  14
    PUSHBUTTON      "Edit",             IDC_BTN_EDIT,  65, 315,  47,  14
    PUSHBUTTON      "Delete",           IDC_BTN_DELETE,128, 315,  55,  14

    /* ---- Right column: connection form ---- */

    LTEXT           "Type:",            -1,           198,   4,  35,   8
    COMBOBOX        IDC_COMBO_KIND,                   237,   2, 281,  40, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Name:",            -1,           198,  22,  35,   8
    EDITTEXT        IDC_EDIT_NAME,                    237,  20, 281,  14, ES_AUTOHSCROLL

    LTEXT           "Host:",            IDC_STATIC_HOST,198,  40,  35,   8
    EDITTEXT        IDC_EDIT_HOST,                    237,  38, 202,  14, ES_AUTOHSCROLL
    LTEXT           "Port:",            IDC_STATIC_PORT,444,  40,  22,   8
    EDITTEXT        IDC_EDIT_PORT,                    469,  38,  49,  14, ES_AUTOHSCROLL | ES_NUMBER

    LTEXT           "User:",            IDC_STATIC_USER,198,  58,  35,   8
    EDITTEXT        IDC_EDIT_USER,                    237,  56, 281,  14, ES_AUTOHSCROLL

    LTEXT           "Auth:",            IDC_STATIC_AUTH,198,  76,  35,   8
    COMBOBOX        IDC_COMBO_AUTH,                   237,  74, 281,  40, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Platform:",        -1,           198,  94,  45,   8
    COMBOBOX        IDC_COMBO_PLATFORM,               237,  92, 281, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    RTEXT           "Password:",        IDC_STATIC_PASS,181, 114,  52,   8
    EDITTEXT        IDC_EDIT_PASS,                    237, 112, 281,  14, ES_PASSWORD | ES_AUTOHSCROLL

    LTEXT           "Key:",             IDC_STATIC_KEY,198, 134,  35,   8
    EDITTEXT        IDC_EDIT_KEYPATH,                 237, 132, 259,  14, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDC_BTN_BROWSE_KEY,        498, 132,  20,  14

    /* Local only: occupies the space Host/Port/User/Auth vacate.  Declared
     * last so it z-orders on top of the rows above; the two sets are never
     * visible at the same time (see toggle_kind_fields in session_manager.c). */
    LTEXT           "Shell (blank = automatic):", IDC_STATIC_SHELL, 198, 40, 160, 8
    COMBOBOX        IDC_EDIT_SHELL,                   198,  52, 320, 100, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP

    RTEXT           "AI Notes:",        -1,           191, 153,  42,   8
    EDITTEXT        IDC_EDIT_AI_NOTES,                237, 150, 267, 117, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN

    PUSHBUTTON      "Save",             IDC_BTN_SAVE, 198, 282,  50,  14
    DEFPUSHBUTTON   "Connect",          IDOK,         412, 282,  55,  14
    PUSHBUTTON      "Cancel",           IDCANCEL,     471, 282,  55,  14
END

IDR_ACORN_PNG  RCDATA  "../../images/nutshell_acorn_transparent.png"
